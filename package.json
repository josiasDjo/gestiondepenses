{
  "devDependencies": {
    "concurrently": "^9.2.1"
  },

  "scripts": {
    "dep_install": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  }
}

